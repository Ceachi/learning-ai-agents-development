# Database
DATABASE_URL=postgresql://analyst:analyst@localhost:5432/document_analyst

# LLM Provider: ollama | google | anthropic
LLM_PROVIDER=anthropic
LLM_MODEL=
LLM_TEMPERATURE=0.0

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434

# Google Gemini
GOOGLE_API_KEY=

# Anthropic Claude
ANTHROPIC_API_KEY=

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# RAG
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5
RAG_THRESHOLD=0.3

# Ingest
INGEST_BATCH_SIZE=100
INGEST_EXTENSIONS=[".pdf", ".txt", ".md"]

# Agents
MAX_ITERATIONS=3
MAX_RETRIES=2
